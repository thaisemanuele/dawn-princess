    "terminal.ansiGreen": "#d6c3f4",
    "terminal.ansiBrightGreen": "#e2d5f7",
    "terminal.ansiYellow": "#f3d9b3",
    "terminal.ansiBrightYellow": "#f7e4ca",
    "terminal.ansiBlue": "#f08db4",
    "terminal.ansiBrightBlue": "#f5afcb",
    "terminal.ansiMagenta": "#f1e0d0",
    "terminal.ansiBrightMagenta": "#f5e9de",
    "terminal.ansiCyan": "#82a6ee",
    "terminal.ansiBrightCyan": "#a8c1f3",
    "terminal.ansiWhite": "#e4dde6",
    "terminal.ansiBrightWhite": "#efe6ec",
    "button.hoverBackground": "#9C5285"
  },
  "tokenColors": [
    {
      "name": "Comment",
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#8f87ae",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Keyword, storage and operator",
      "scope": [
        "keyword",
        "storage",
        "keyword.operator"
      ],
      "settings": {
        "foreground": "#f08db4"
      }
    },
    {
      "name": "Control flow and module keywords (import, export, return, if)",
      "scope": [
        "keyword.control",
        "keyword.control.import",
        "keyword.control.export",
        "keyword.control.from",
        "keyword.control.flow",
        "keyword.control.conditional",
        "keyword.control.loop"
      ],
      "settings": {
        "foreground": "#F08DB4",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Language constant (true, false, null, undefined)",
      "scope": [
        "constant.language"
      ],
      "settings": {
        "foreground": "#f08db4"
      }
    },
    {
      "name": "Template expression ${}",
      "scope": [
        "punctuation.definition.template-expression"
      ],
      "settings": {
        "foreground": "#f08db4"
      }
    },
    {
      "name": "HTML and JSX tag",
      "scope": [
        "entity.name.tag",
        "support.class.component"
      ],
      "settings": {
        "foreground": "#f08db4"
      }
    },
    {
      "name": "Function and method",
      "scope": [
        "entity.name.function",
        "support.function",
        "meta.function-call entity.name.function"
      ],
      "settings": {
        "foreground": "#d6c3f4"
      }
    },
    {
      "name": "Property key (JSON, object literal, CSS)",
      "scope": [
        "support.type.property-name",
        "meta.object-literal.key"
      ],
      "settings": {
        "foreground": "#d6c3f4"
      }
    },
    {
      "name": "JSX and HTML attribute",
      "scope": [
        "entity.other.attribute-name"
      ],
      "settings": {
        "foreground": "#D6C3F4"
      }
    },
    {
      "name": "String",
      "scope": [
        "string",
        "punctuation.definition.string"
      ],
      "settings": {
        "foreground": "#f6ccbc"
      }
    },
    {
      "name": "Type, class and interface",
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "support.type",
        "support.class",
        "entity.other.inherited-class"
      ],
      "settings": {
        "foreground": "#82a6ee",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Number",
      "scope": [
        "constant.numeric"
      ],
      "settings": {
        "foreground": "#82a6ee"
      }
    },
    {
      "name": "Rare accents: this, regex, escapes",
      "scope": [
        "variable.language",
        "string.regexp",
        "constant.character.escape"
      ],
      "settings": {
        "foreground": "#f3d9b3",
        "fontStyle": "italic"
      }
    }
  ],
  "semanticTokenColors": {
    "function": "#d6c3f4",
    "method": "#d6c3f4",
    "class": {
      "foreground": "#82a6ee",
      "italic": true
    },
    "type": {
      "foreground": "#82a6ee",
      "italic": true
    },
    "interface": {
      "foreground": "#82a6ee",
      "italic": true
    },
    "typeParameter": {
      "foreground": "#82a6ee",
      "italic": true
    },
    "enum": {
      "foreground": "#82a6ee",
      "italic": true
    },
    "enumMember": {
      "foreground": "#f3d9b3",
      "italic": true
    },
    "property.declaration": "#efe6ec",
    "parameter": {},
    "property": "#efe6ec"
  }
}
