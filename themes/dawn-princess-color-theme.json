    "terminal.ansiBrightCyan": "#f9d7d3",
    "terminal.ansiWhite": "#e7dfe8",
    "terminal.ansiBrightWhite": "#f3e8ee",
    "button.hoverBackground": "#7E5C99"
  },
  "tokenColors": [
    {
      "name": "Comment",
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#8d8db4",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Keyword, storage and operator",
      "scope": [
        "keyword",
        "storage",
        "keyword.operator"
      ],
      "settings": {
        "foreground": "#c49be2"
      }
    },
    {
      "name": "Control flow and module keywords (import, export, return, if)",
      "scope": [
        "keyword.control",
        "keyword.control.import",
        "keyword.control.export",
        "keyword.control.from",
        "keyword.control.flow",
        "keyword.control.conditional",
        "keyword.control.loop"
      ],
      "settings": {
        "foreground": "#DDB8F2",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Language constant (true, false, null, undefined)",
      "scope": [
        "constant.language"
      ],
      "settings": {
        "foreground": "#c49be2"
      }
    },
    {
      "name": "Template expression ${}",
      "scope": [
        "punctuation.definition.template-expression"
      ],
      "settings": {
        "foreground": "#c49be2"
      }
    },
    {
      "name": "HTML and JSX tag",
      "scope": [
        "entity.name.tag",
        "support.class.component"
      ],
      "settings": {
        "foreground": "#c49be2"
      }
    },
    {
      "name": "Function and method",
      "scope": [
        "entity.name.function",
        "support.function",
        "meta.function-call entity.name.function"
      ],
      "settings": {
        "foreground": "#b4ccf7"
      }
    },
    {
      "name": "Property key (JSON, object literal, CSS)",
      "scope": [
        "support.type.property-name",
        "meta.object-literal.key"
      ],
      "settings": {
        "foreground": "#b4ccf7"
      }
    },
    {
      "name": "JSX and HTML attribute",
      "scope": [
        "entity.other.attribute-name"
      ],
      "settings": {
        "foreground": "#b4ccf7",
        "fontStyle": "italic"
      }
    },
    {
      "name": "String",
      "scope": [
        "string",
        "punctuation.definition.string"
      ],
      "settings": {
        "foreground": "#ec8db3"
      }
    },
    {
      "name": "Type, class and interface",
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "support.type",
        "support.class",
        "entity.other.inherited-class"
      ],
      "settings": {
        "foreground": "#f6c6c0",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Number",
      "scope": [
        "constant.numeric"
      ],
      "settings": {
        "foreground": "#f6c6c0"
      }
    },
    {
      "name": "Rare accents: this, regex, escapes",
      "scope": [
        "variable.language",
        "string.regexp",
        "constant.character.escape"
      ],
      "settings": {
        "foreground": "#f3d9b3",
        "fontStyle": "italic"
      }
    }
  ],
  "semanticTokenColors": {
    "function": "#b4ccf7",
    "method": "#b4ccf7",
    "class": {
      "foreground": "#f6c6c0",
      "italic": true
    },
    "type": {
      "foreground": "#f6c6c0",
      "italic": true
    },
    "interface": {
      "foreground": "#f6c6c0",
      "italic": true
    },
    "typeParameter": {
      "foreground": "#f6c6c0",
      "italic": true
    },
    "enum": {
      "foreground": "#f6c6c0",
      "italic": true
    },
    "enumMember": {
      "foreground": "#f3d9b3",
      "italic": true
    },
    "property.declaration": "#f3e8ee",
    "parameter": {
      "italic": true
    },
    "property": "#f3e8ee"
  }
}
